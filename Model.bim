        ],
        "measures": [
          {
            "name": "base_measure",
            "expression": [
              "",
              "IF( HASONEVALUE( dim_fred_series[series_id] ),",
              "    AVERAGE( fact_fred_observations[value] )",
              ")"
            ],
            "formatString": "#,0.00",
            "isHidden": true,
            "lineageTag": "c5dff7ad-4be1-4525-9bcf-972f137cc4fb",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              },
              {
                "property": "IsHidden"
              }
            ]
          },
          {
            "name": "MoM%",
            "expression": [
              "",
              "VAR _current = [base_measure]",
              "VAR _prev = CALCULATE( [base_measure], DATEADD( dim_date[date], -1, MONTH ) )",
              "RETURN",
              "IF( NOT ISBLANK( _current ) && NOT ISBLANK( _prev ),",
              "    DIVIDE( _current - _prev, _prev )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "c8daa706-fa90-49f9-a889-dab9c1b0e170",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "YoY%",
            "expression": [
              "",
              "VAR _current = [base_measure]",
              "VAR _prev = CALCULATE( [base_measure], DATEADD( dim_date[date], -1, YEAR ) )",
              "RETURN",
              "IF( NOT ISBLANK( _current ) && NOT ISBLANK( _prev ),",
              "    DIVIDE( _current - _prev, _prev )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "48298c33-6c13-4855-b6e5-1384cd51cddd",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ]
          },
          {
            "name": "Total Chg%",
            "expression": [
              "",
              "VAR _prev =",
              "CALCULATE(",
              "    FIRSTNONBLANKVALUE( dim_date[date], [base_measure] ),",
              "    ALLSELECTED( dim_date )",
              ")",
              "VAR _current = [base_measure]",
              "RETURN",
              "IF( NOT ISBLANK( _current ) && NOT ISBLANK( _prev ),",
              "    DIVIDE( _current - _prev, _prev )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "f24f3bd2-99f0-481a-ad21-ee7573108612",
            "changedProperties": [
              {
                "property": "Name"
              },
              {
                "property": "FormatString"
              }
            ]
          }
        ]
      }
