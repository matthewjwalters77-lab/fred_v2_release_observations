        "name": "DirectLake - Semantic Model",
        "kind": "m",
        "expression": [
          "let",
          "    workspace_id = \"[Paste target workspace_id]\",",
          "    lakehouse_id = \"[Paste target lakehouse_id]\",",
          "    Source = AzureStorage.DataLake(\"https://onelake.dfs.fabric.microsoft.com/\" & workspace_id & \"/\" & lakehouse_id, [HierarchicalNavigation=true])",
          "in",
          "    Source"
        ],
        "lineageTag": "c7c128ed-257d-4d60-a297-ee9e1b792570",
